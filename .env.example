# Supabase — Sprint 2.1. NAMES ONLY, never real values.
#
# Generated from the workspace-root .env, with the project ref corrected to
# lmohoeikidbsiioabmsz (the root file's Postgres user carried an extra "i").
#
# Never committed: .gitignore ignores .env*. These values must also be set in
# the Vercel project settings for deployed builds.
#
# NEXT_PUBLIC_* are compiled into the browser bundle and are meant to be
# public. The anon key is safe there ONLY because Row Level Security decides
# what it can actually read; it is not a secret, RLS is the security boundary.

NEXT_PUBLIC_SUPABASE_URL=https://lmohoeikidbsiioabmsz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security entirely, so it must never be
# prefixed NEXT_PUBLIC_ and must never be imported into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, for migrations run from the CLI.
# Password is percent-encoded so shell/URL parsing cannot mangle it.
SUPABASE_DB_URL=postgresql://postgres.lmohoeikidbsiioabmsz:@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Transactional email (registration confirmations, schedule-change notices).
# PLACEHOLDER, WAITING ON A KEY — not set anywhere yet. These are NOT read by
# Next.js: they belong to the send-email Edge Function and are set via
# `npx supabase secrets set`, not this file. Listed here only so the gap is
# visible next to the rest of the environment. See
# supabase/functions/send-email/index.ts for the exact activation commands.
# RESEND_API_KEY=
# RESEND_FROM_ADDRESS="SAEAC <registrations@saeac.org>"
