# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. NEVER commit these: they carry the Supabase service-role key,
# which bypasses Row Level Security entirely. .env.example is the one
# exception, and it holds names only, never values.
.env
.env.*
!.env.example

# Supabase CLI local state
.branches
.temp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Phase 0 review artifacts
shots/
